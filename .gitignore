# ---- 构建产物（全部可由 build_plugin.py / build_package.py 重新生成）----
/dist/
/tests/build/

# ---- cppwinrt 生成的 WinRT 投影头（约 64 MB，生成物，不要手改）----
/winrt_gen/

# ---- 编译中间产物 ----
*.o
*.obj
*.lib
*.exp
*.pdb
*.ilk
*.res

# ---- 旧实现（v2 .NET 服务 / v3 单 DLL）----
