/_legacy/

# ---- 运行时数据（插件自己写在 %LOCALAPPDATA%）----
*.db
*.db-shm
*.db-wal
testdata/
__pycache__/
*.pyc

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
Thumbs.db
desktop.ini
nul
